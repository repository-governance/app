<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension point="org.eclipse.ui.commands">
      <category id="org.cda.archi.githubworkspace.category" name="GitHub Workspace"/>
      <command id="org.cda.archi.githubworkspace.browseRepositories"
               name="Browse Repositories..."
               categoryId="org.cda.archi.githubworkspace.category"/>
   </extension>
   <extension point="org.eclipse.ui.handlers">
      <handler class="org.cda.archi.githubworkspace.controllers.GitHubWorkspaceController"
               commandId="org.cda.archi.githubworkspace.browseRepositories"/>
   </extension>
   <extension point="org.eclipse.ui.menus">
       <menuContribution locationURI="menu:file?before=fileEnd">
         <menu id="org.cda.archi.githubworkspace.menu" label="GitHub Workspace">
            <command commandId="org.cda.archi.githubworkspace.browseRepositories"
                     id="org.cda.archi.githubworkspace.browseRepositories.menu"
                     label="Browse Repositories..."
                     style="push"/>
         </menu>
      </menuContribution>
   </extension>
   <extension point="org.eclipse.ui.preferencePages">
      <page id="org.cda.archi.githubworkspace.preferences"
            name="GitHub Workspace"
            class="org.cda.archi.githubworkspace.views.GitHubWorkspacePreferencePage"/>
   </extension>
</plugin>

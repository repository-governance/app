   <extension point="org.eclipse.ui.menus">
      <menuContribution locationURI="menu:org.eclipse.ui.main.menu?after=additions">
         <menu id="org.cda.archi.governance.menu" label="Governance">
            <command commandId="org.cda.archi.governance.repositories"
                     id="org.cda.archi.governance.repositories.menu"
                     label="GitHub Repositories…"
                     style="push"/>
         </menu>
      </menuContribution>

<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension point="org.eclipse.ui.commands">
      <category id="org.cda.archi.governance.category" name="Governance"/>
      <command id="org.cda.archi.governance.repositories"
               name="GitHub Repositories"
               categoryId="org.cda.archi.governance.category"/>
   </extension>
   <extension point="org.eclipse.ui.handlers">
      <handler class="org.cda.archi.governance.controllers.GovernanceController"
               commandId="org.cda.archi.governance.repositories"/>
